[Unit]
Description=Update Rawrarr do3 coordinators from published GitHub main
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RAWARR_GITHUB_TOKEN_FILE=/root/gh-token
ExecStart=/usr/bin/python3 /opt/rawrarr-coordinator-auto-updater/auto_update_coordinators.py
TimeoutStartSec=infinity
Nice=5

[Install]
WantedBy=multi-user.target
