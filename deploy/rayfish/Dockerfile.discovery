FROM alpine:3.22
RUN apk add --no-cache python3 py3-cryptography \
    && addgroup -g 10001 discovery \
    && adduser -D -u 10001 -G discovery discovery \
    && install -d -o 10001 -g 10001 -m 0700 /state
COPY deploy/rayfish/discovery.py /opt/rawrarr/discovery.py
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python3", "/opt/rawrarr/discovery.py"]
